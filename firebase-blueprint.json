    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly visible profile details for a verified Verve member (contains no PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "bio": { "type": "string", "maxLength": 320 },
        "location": { "type": "string", "maxLength": 80 },
        "work": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 450000 },
        "coverUrl": { "type": "string", "maxLength": 450000 },
        "visibility": { "type": "string", "enum": ["public"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "name",
        "bio",
        "location",
        "work",
        "avatarUrl",
        "coverUrl",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
