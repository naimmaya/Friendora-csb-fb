        "callerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "callerName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "callerAvatar": { "type": "string", "maxLength": 450000 },
        "receiverId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiverName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "receiverAvatar": { "type": "string", "maxLength": 450000 },
        "participantUids": { "type": "array" },
        "type": { "type": "string", "enum": ["audio", "video"] },
        "status": { "type": "string", "enum": ["ringing", "accepted", "declined", "ended", "missed"] },
        "offerSdp": { "type": "string", "maxLength": 65536 },
        "offerType": { "type": "string", "enum": ["", "offer"] },
        "answerSdp": { "type": "string", "maxLength": 65536 },
        "answerType": { "type": "string", "enum": ["", "answer"] },
        "durationSec": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "callerId",
        "callerName",
        "callerAvatar",
        "receiverId",
        "receiverName",
        "receiverAvatar",
        "participantUids",
        "type",
        "status",
        "offerSdp",
        "offerType",
        "answerSdp",
        "answerType",
        "durationSec",
        "timestamp",
        "updatedAt"
      ]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "description": "WebRTC ICE candidate for 1-on-1 peer connection negotiation.",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantUids": { "type": "array" },
        "candidate": { "type": "string", "maxLength": 4096 },
        "sdpMid": { "type": "string", "maxLength": 64 },
        "sdpMLineIndex": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "participantUids", "candidate", "sdpMid", "sdpMLineIndex", "createdAt"]
    }
  },
