rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedUser() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        (request.auth.token.phone_number is string && request.auth.token.phone_number.size() >= 7)
      );
    }

    // Chat photos (max 15 MB, image/* only)
    match /chat_images/{chatId}/{fileName} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser()
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isVerifiedUser();
    }

    // Chat voice notes (max 20 MB, audio/* only)
    match /chat_voices/{chatId}/{fileName} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser()
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isVerifiedUser();
    }

    // Chat videos & documents (max 100 MB)
    match /chat_media/{chatId}/{fileName} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser()
        && request.resource.size <= 100 * 1024 * 1024;
      allow delete: if isVerifiedUser();
    }

    // Post videos (max 100 MB, owner write/delete, authenticated read)
    match /post_videos/{userId}/{fileName} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Post photos (max 15 MB, owner write/delete)
    match /post_images/{userId}/{fileName} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Page posts media
    match /pages/{pageId}/{allPaths=**} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser()
        && request.resource.size <= 100 * 1024 * 1024;
      allow delete: if isVerifiedUser();
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
